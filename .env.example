# Application
APP_URL=http://localhost
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL 17
DB_HOST=db
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=demo
DB_URL=postgresql+psycopg2://admin:admin123@db:5432/demo

# Redis 7 (Celery broker, cache, rate limits)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Google Gemini (LLM + embeddings)
GOOGLE_API_KEY=your-google-api-key

# Pinecone (vector store)
PINECONE_API_KEY=your-pinecone-api-key

# SMTP (registration emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

MAX_UPLOAD_FILE_SIZE_MB=50
MAX_UPLOAD_REQUEST_SIZE_MB=200
DEFAULT_VECTOR_INDEX=vector_db_index

# MCP server URLs (used by agents inside Docker network)
MCP_ORCHESTRATOR_URL=http://mcp-orchestrator:8001/mcp/
MCP_PLANNER_URL=http://mcp-planner:8002/mcp/
MCP_TUTOR_URL=http://mcp-tutor:8003/mcp/
MCP_CRITIC_URL=http://mcp-critic:8004/mcp/
MCP_NOTES_URL=http://mcp-notes:8005/mcp/
