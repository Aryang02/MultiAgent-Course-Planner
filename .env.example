# Application
APP_URL=http://localhost
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL 17
DB_HOST=db
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=demo
DB_URL=postgresql+psycopg2://admin:admin123@db:5432/demo

# Redis 7 (Celery broker, cache, rate limits)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# LLM provider configuration (LiteLLM — supports OpenAI, Anthropic, Gemini, etc.)
# Provider API keys are read automatically by LiteLLM from env vars:
#   OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY, etc.
LLM_MODEL=gemini/gemini-1.5-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIMENSION=768

# Google Gemini (used when LLM_MODEL or EMBEDDING_MODEL targets Gemini)
GOOGLE_API_KEY=your-google-api-key

# Pinecone (vector store)
PINECONE_API_KEY=your-pinecone-api-key

# SMTP (registration emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

MAX_UPLOAD_FILE_SIZE_MB=50
MAX_UPLOAD_REQUEST_SIZE_MB=200
DEFAULT_VECTOR_INDEX=vector_db_index

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
ENVIRONMENT=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
API_SERVER=gunicorn
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# MCP server URLs (used by agents inside Docker network)
MCP_ORCHESTRATOR_URL=http://mcp-orchestrator:8001/mcp/
MCP_PLANNER_URL=http://mcp-planner:8002/mcp/
MCP_TUTOR_URL=http://mcp-tutor:8003/mcp/
MCP_CRITIC_URL=http://mcp-critic:8004/mcp/
MCP_NOTES_URL=http://mcp-notes:8005/mcp/
